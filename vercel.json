{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    { "source": "/photo", "destination": "https://firstunit.io/fu-0001", "permanent": true },
    { "source": "/photo/", "destination": "https://firstunit.io/fu-0001", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*).(avif|jpg|JPG|jpeg|png|webp|svg|ico|woff2)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }]
    },
    {
      "source": "/(.*).(css|js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/docs/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/AGENTS.md",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/CLAUDE.md",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/Resume.pdf",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "Access-Control-Allow-Origin", "value": "https://isaacperez.co" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'sha256-5EZdU3aqmWuKypSdUOPvD7EJVdkBFQJTXDVDWCCFXQA=' 'sha256-FaeW4ez8M+r2qi5jBF3Nb39CjIvVpmfGMV9OFV+yOQk=' 'sha256-8LVBjGWMCB2Gw+MnkIjJ5st+7AnEaVmfxgYDThH3ZKE=' 'sha256-asb06PDxe3/K8QyRQCYAKp8rm0351/P3OAvfeqFmsFQ=' 'sha256-isx2zqeU2cCiVILeEJz7gA3xZpK/3KBC7i50ouOoIMk='; connect-src 'self'"
        }
      ]
    }
  ]
}
